/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cosmos-video-server",
	"main": "worker/index.ts",
	"compatibility_date": "2025-10-08",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application",
		// Send /api/* to the Worker instead of the static assets
		"run_worker_first": ["/api/*"]
	},
	"observability": {
		"enabled": true
	},
	/**
	 * Secrets (set with `npx wrangler secret put <NAME>`, never commit them):
	 * - WAVESPEED_API_KEY: your WaveSpeed AI API key
	 * - ACCESS_PASSWORD: password the app asks for, so strangers can't spend your credits
	 */
	"upload_source_maps": true
}
